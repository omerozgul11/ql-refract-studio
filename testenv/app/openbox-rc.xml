<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal Openbox configuration: the Refraction Studio main window opens maximised. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <placement><policy>Smart</policy><center>yes</center></placement>
  <theme><name>Clearlooks</name><titleLayout>NLIMC</titleLayout><keepBorder>no</keepBorder></theme>
  <desktops><number>1</number></desktops>
  <applications>
    <application class="RefractionStudio" type="normal">
      <maximized>yes</maximized><decor>no</decor>
    </application>
  </applications>
</openbox_config>
