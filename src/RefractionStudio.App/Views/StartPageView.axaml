<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RefractionStudio.App.ViewModels"
             xmlns:p="using:RefractionStudio.Persistence"
             x:Class="RefractionStudio.App.Views.StartPageView"
             x:DataType="vm:StartPageViewModel">
  <ScrollViewer>
    <StackPanel>
      <!-- ───────────── QuakeLogic hero band ───────────── -->
      <Border Background="{DynamicResource HeaderBackground}" Padding="0,34,0,38">
        <Grid ColumnDefinitions="*,Auto,*">
          <Grid Grid.Column="1" Width="920" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <Image Source="/Assets/Brand/quakelogic-logo-white.png" Height="20" HorizontalAlignment="Left" Margin="0,0,0,22" />
              <TextBlock Text="Refraction Studio" FontFamily="{DynamicResource BrandLabelFont}" FontSize="46" FontWeight="SemiBold"
                         Foreground="{DynamicResource HeaderForeground}" />
              <TextBlock Text="SEISMIC REFRACTION ANALYSIS · P AND SH WAVES" FontFamily="{DynamicResource BrandLabelFont}" FontSize="14"
                         LetterSpacing="2.2" Foreground="{DynamicResource BrandOrangeBrush}" />
              <TextBlock Text="From field records to a finished report: picking, layered models, tomography, Vs30 and quality control."
                         Foreground="{DynamicResource HeaderMuted}" FontSize="15" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,6,0,0" />
            </StackPanel>
            <!-- What the product does: refracted ray from the source to the geophones -->
            <Canvas Grid.Column="1" Width="320" Height="170" VerticalAlignment="Center" Margin="24,0,0,0">
              <Line StartPoint="0,52" EndPoint="320,52" Stroke="#FFFFFF" StrokeThickness="2" />
              <Line StartPoint="0,138" EndPoint="320,138" Stroke="#58595B" StrokeThickness="2" StrokeDashArray="4,3" />
              <TextBlock Canvas.Left="236" Canvas.Top="144" Text="REFRACTOR" FontFamily="{DynamicResource BrandLabelFont}" FontSize="10" LetterSpacing="1.5" Foreground="#77787B" />
              <Polyline Points="30,52 74,138 238,138 282,52" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="3" StrokeJoin="Round" />
              <Ellipse Canvas.Left="23" Canvas.Top="38" Width="14" Height="14" Fill="{DynamicResource BrandOrangeBrush}" />
              <Path Data="M 166,36 L 178,36 L 172,47 Z M 196,36 L 208,36 L 202,47 Z M 226,36 L 238,36 L 232,47 Z M 256,36 L 268,36 L 262,47 Z M 286,36 L 298,36 L 292,47 Z" Fill="#FFFFFF" />
            </Canvas>
          </Grid>
        </Grid>
      </Border>

    <Grid ColumnDefinitions="*,Auto,*" Margin="24,28,24,36">
      <StackPanel Grid.Column="1" Width="920" Spacing="18">
        <UniformGrid Columns="4">
          <Button Classes="big" Command="{Binding NewProjectCommand}" Margin="0,0,8,0" ToolTip.Tip="Ctrl+N">
            <StackPanel Spacing="6">
              <PathIcon Data="{StaticResource Icon.New}" Width="22" Height="22" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
              <TextBlock Text="New project" FontWeight="SemiBold" />
              <TextBlock Text="Start an empty project" Classes="caption" />
            </StackPanel>
          </Button>
          <Button Classes="big" Command="{Binding OpenProjectCommand}" Margin="4,0" ToolTip.Tip="Ctrl+O">
            <StackPanel Spacing="6">
              <PathIcon Data="{StaticResource Icon.Open}" Width="22" Height="22" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Open project" FontWeight="SemiBold" />
              <TextBlock Text="Open a .rfsx project file" Classes="caption" />
            </StackPanel>
          </Button>
          <Button Classes="big" Command="{Binding ImportSurveyCommand}" Margin="4,0" ToolTip.Tip="Ctrl+I">
            <StackPanel Spacing="6">
              <PathIcon Data="{StaticResource Icon.Import}" Width="22" Height="22" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Import survey" FontWeight="SemiBold" />
              <TextBlock Text="SEG-2 or SEG-Y shot files" Classes="caption" />
            </StackPanel>
          </Button>
          <Button Classes="big" Command="{Binding OpenSampleCommand}" Margin="8,0,0,0">
            <StackPanel Spacing="6">
              <PathIcon Data="{StaticResource Icon.Sample}" Width="22" Height="22" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Explore the sample" FontWeight="SemiBold" />
              <TextBlock Text="A complete P and SH survey" Classes="caption" />
            </StackPanel>
          </Button>
        </UniformGrid>

        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="Recent projects" Classes="h2" />
            <TextBlock Text="No recent projects yet. Projects you open or save appear here." Classes="muted" IsVisible="{Binding !HasRecent}" Margin="0,4" />
            <ItemsControl ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:RecentProject">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <Button Classes="big" Padding="10,7" BorderThickness="0" Background="Transparent"
                            Command="{Binding $parent[UserControl].((vm:StartPageViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path}" Classes="caption" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding OpenedAt, StringFormat='{}{0:d MMM yyyy HH:mm}'}" Classes="caption" VerticalAlignment="Center" Margin="10,0" />
                    <ToggleButton Grid.Column="2" IsChecked="{Binding Pinned, Mode=OneWay}" Padding="6" Background="Transparent" BorderThickness="0"
                                  Command="{Binding $parent[UserControl].((vm:StartPageViewModel)DataContext).TogglePinCommand}" CommandParameter="{Binding}"
                                  ToolTip.Tip="Pin or unpin">
                      <TextBlock Text="📌" FontSize="12" />
                    </ToggleButton>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="Getting started" Classes="h2" />
            <TextBlock TextWrapping="Wrap" Text="The workflow on the left guides you from data import to the report: Project → Import → Geometry → Waveforms → Processing → P and SH picks → Quality control → Velocity model → Engineering → Results → Report. Each step shows its status, and Guided mode explains what to do. Press F1 on any page for help, or Ctrl+K to find any command." />
            <TextBlock TextWrapping="Wrap" Classes="muted" Text="Raw data are never modified: processing, picks and interpretations are stored as a history of reversible steps, and every change can be undone." />
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="{Binding Version}" Classes="muted" />
            <TextBlock Text="{Binding UpdateStatus}" Classes="caption" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Install update" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding UpdateAvailable}" />
            <Button Classes="secondary" Command="{Binding CheckForUpdatesCommand}" CommandParameter="{x:False}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.Update}" Width="13" Height="13" />
                <TextBlock Text="Check for updates" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="caption" Text="QuakeLogic Inc. · 2008 Opportunity Dr., Suite 130, Roseville, CA 95678, USA · +1 (916) 899-0391 · products.quakelogic.net" VerticalAlignment="Center" />
            <Image Grid.Column="1" Source="/Assets/Brand/quakelogic-logo.png" Height="14" VerticalAlignment="Center" Margin="16,0,0,0" />
          </Grid>
        </Border>
      </StackPanel>
    </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
