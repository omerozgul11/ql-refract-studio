<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RefractionStudio.App.ViewModels"
             xmlns:p="using:RefractionStudio.Persistence"
             x:Class="RefractionStudio.App.Views.ReportPageView"
             x:DataType="vm:ReportPageViewModel">
  <Grid ColumnDefinitions="*,14,360">
    <ScrollViewer>
      <StackPanel>
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="Report details" Classes="h2" />
            <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto,Auto">
              <StackPanel Grid.ColumnSpan="3">
                <TextBlock Text="Title" Classes="label" />
                <TextBox Text="{Binding ReportTitle}" />
              </StackPanel>
              <StackPanel Grid.Row="1">
                <TextBlock Text="Subtitle" Classes="label" />
                <TextBox Text="{Binding Subtitle}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Report number" Classes="label" />
                <TextBox Text="{Binding ReportNumber}" />
              </StackPanel>
              <StackPanel Grid.Row="2">
                <TextBlock Text="Prepared by" Classes="label" />
                <TextBox Text="{Binding PreparedBy}" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="Checked by" Classes="label" />
                <TextBox Text="{Binding CheckedBy}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Processing notes" Classes="label" />
            <TextBox Text="{Binding ProcessingNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                     PlaceholderText="Remarks on data quality, processing and interpretation choices" />
            <TextBlock Text="Conclusions" Classes="label" />
            <TextBox Text="{Binding Conclusions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                     PlaceholderText="Your interpretation and conclusions. The report never writes conclusions for you." />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Classes="secondary" Content="Save in project" Command="{Binding ApplySettingsCommand}" />
              <TextBlock Text="{Binding Message}" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="Sections" Classes="h2" />
            <ItemsControl ItemsSource="{Binding Sections}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SectionToggle">
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox Content="Include every shot gather (otherwise a representative selection)" IsChecked="{Binding IncludeAllGathers}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="2">
      <StackPanel>
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="Output" Classes="h2" />
            <TextBlock Text="Units" Classes="label" />
            <ComboBox ItemsSource="{Binding UnitSystems}" SelectedItem="{Binding Units}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Paper size" Classes="label" />
            <ComboBox ItemsSource="{Binding Papers}" SelectedItem="{Binding Paper}" HorizontalAlignment="Stretch" />
            <Button Classes="primary" Command="{Binding GenerateCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,14,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Report}" Width="14" Height="14" Foreground="{DynamicResource AccentText}" />
                <TextBlock Text="Generate PDF report…" />
              </StackPanel>
            </Button>
            <Button Classes="link" Content="Open the last report" Command="{Binding OpenReportCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"
                    IsVisible="{Binding LastReport, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="Branding" Classes="h2" />
            <TextBlock Classes="muted" TextWrapping="Wrap">
              <Run Text="Company: " /><Run Text="{Binding CompanyName}" FontWeight="SemiBold" />
            </TextBlock>
            <Button Classes="secondary" Content="Use my company branding" Command="{Binding UseCompanyBrandingCommand}" Margin="0,6,0,0"
                    ToolTip.Tip="Name, logo, contact details and footer from Settings → Reporting" />
            <TextBlock Text="Templates" Classes="label" Margin="0,12,0,2" />
            <Grid ColumnDefinitions="*,Auto">
              <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" HorizontalAlignment="Stretch" PlaceholderText="Choose a template">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="p:ReportTemplate">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Classes="secondary" Content="Apply" Command="{Binding ApplyTemplateCommand}" Margin="6,0,0,4" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding TemplateName}" PlaceholderText="Template name" />
              <Button Grid.Column="1" Classes="secondary" Content="Save" Command="{Binding SaveTemplateCommand}" Margin="6,0,0,4" />
            </Grid>
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="A template stores the branding and the selected sections for reuse in other projects." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
