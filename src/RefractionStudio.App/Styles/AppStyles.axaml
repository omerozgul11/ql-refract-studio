<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackground}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="Margin" Value="0,8,0,4" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,6,0,2" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Panels -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.ok">
    <Setter Property="Background" Value="{DynamicResource OkBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
  </Style>
  <Style Selector="Border.review">
    <Setter Property="Background" Value="{DynamicResource ReviewBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReviewBrush}" />
  </Style>
  <Style Selector="Border.problem">
    <Setter Property="Background" Value="{DynamicResource ProblemBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ProblemBrush}" />
  </Style>
  <Style Selector="Border.info">
    <Setter Property="Background" Value="{DynamicResource InfoBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.callout">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <!-- Toolbar -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinWidth" Value="58" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.tool PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Button.tool TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Button.tool:disabled PathIcon, Button.tool:disabled TextBlock">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.big">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.big:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>

  <!-- Navigation -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
  </Style>

  <!-- Inputs -->
  <Style Selector="NumericUpDown">
    <Setter Property="MinWidth" Value="110" />
  </Style>
  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Data grids -->
  <Style Selector="DataGrid">
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="RowHeight" Value="26" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- Status glyphs -->
  <Style Selector="TextBlock.ok">
    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource ReviewBrush}" />
  </Style>
  <Style Selector="TextBlock.bad">
    <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
  </Style>
  <Style Selector="PathIcon.ok">
    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
  </Style>
  <Style Selector="PathIcon.warn">
    <Setter Property="Foreground" Value="{DynamicResource ReviewBrush}" />
  </Style>
  <Style Selector="PathIcon.bad">
    <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
  </Style>
  <Style Selector="TextBox.problem">
    <Setter Property="BorderBrush" Value="{DynamicResource ProblemBrush}" />
  </Style>
  <Style Selector="TextBlock.progress">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, Menlo, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.section">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="TabControl.page">
    <Setter Property="Padding" Value="0,8,0,0" />
  </Style>
  <Style Selector="TabControl.page TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
</Styles>
