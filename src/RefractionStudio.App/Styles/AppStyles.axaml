<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    QuakeLogic house style for the desktop application: white content on a light neutral background,
    hairline dividers, generous spacing, Barlow text, Oswald uppercase labels, a near-black header and
    orange used only as an accent (selection, focus, key marks).
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackground}" />
    <Setter Property="FontFamily" Value="{DynamicResource BrandFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>

  <!-- ───────────── Typography ───────────── -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="25" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="Margin" Value="0,10,0,6" />
  </Style>
  <!-- Uppercase section label (Oswald, tracked). -->
  <Style Selector="TextBlock.overline">
    <Setter Property="FontFamily" Value="{DynamicResource BrandLabelFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="LetterSpacing" Value="1.6" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,8,0,4" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ───────────── Surfaces ───────────── -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style Selector="Border.section">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12,16,14" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <!-- Status tints: a soft background; the colour itself is carried by the icon. -->
  <Style Selector="Border.ok">
    <Setter Property="Background" Value="{DynamicResource OkBackground}" />
  </Style>
  <Style Selector="Border.review">
    <Setter Property="Background" Value="{DynamicResource ReviewBackground}" />
  </Style>
  <Style Selector="Border.problem">
    <Setter Property="Background" Value="{DynamicResource ProblemBackground}" />
  </Style>
  <Style Selector="Border.info">
    <Setter Property="Background" Value="{DynamicResource InfoBackground}" />
  </Style>
  <!-- Inline note: rounded, tinted, no coloured edge. -->
  <Style Selector="Border.callout">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="Border.callout.review PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource ReviewBrush}" />
  </Style>
  <Style Selector="Border.callout.problem PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
  </Style>
  <Style Selector="Border.callout.ok PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
  </Style>

  <!-- ───────────── Header (near-black band) ───────────── -->
  <Style Selector="Border.header">
    <Setter Property="Background" Value="{DynamicResource HeaderBackground}" />
  </Style>
  <Style Selector="Border.header TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
  </Style>
  <Style Selector="Border.header TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource HeaderMuted}" />
  </Style>
  <Style Selector="Border.header TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource HeaderMuted}" />
  </Style>
  <Style Selector="Border.header ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
  </Style>
  <Style Selector="Button.header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
  </Style>
  <Style Selector="Button.header:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HeaderHover}" />
  </Style>
  <Style Selector="Button.header:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HeaderDivider}" />
  </Style>
  <Style Selector="Button.header PathIcon">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
  </Style>
  <Style Selector="Button.header TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource HeaderMuted}" />
  </Style>
  <Style Selector="Button.header:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
  </Style>
  <Style Selector="Button.header:disabled PathIcon, Button.header:disabled TextBlock">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.header:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Segmented control (Guided / Expert) on the dark header. -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource HeaderHover}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource HeaderMuted}" />
  </Style>
  <Style Selector="Button.segment:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
  </Style>
  <Style Selector="Button.segment.selected">
    <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.segment.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#45454C" />
  </Style>
  <Style Selector="Button.segment.selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#45454C" />
  </Style>
  <!-- Search-style button that opens the command palette. -->
  <Style Selector="Button.search">
    <Setter Property="Background" Value="{DynamicResource HeaderHover}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HeaderDivider}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinWidth" Value="210" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.search:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HeaderDivider}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HeaderDivider}" />
  </Style>
  <Style Selector="Button.search TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HeaderMuted}" />
  </Style>
  <Style Selector="Button.search PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource HeaderMuted}" />
  </Style>

  <!-- ───────────── Buttons ───────────── -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.tool PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Button.tool TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Button.tool:disabled PathIcon, Button.tool:disabled TextBlock">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <!-- Primary action: solid ink (white in dark mode); orange stays an accent. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryButtonHover}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
  </Style>
  <Style Selector="Button.primary PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
  </Style>
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
  </Style>
  <Style Selector="Button.primary:disabled PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
  </Style>
  <Style Selector="Button.primary:disabled TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="13,7" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.big">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.big:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ───────────── Navigation (sidebar) ───────────── -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="8,1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #1A000000" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected TextBlock.navtitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected PathIcon.navicon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="PathIcon.navicon">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
  </Style>

  <!-- ───────────── Inputs ───────────── -->
  <Style Selector="NumericUpDown">
    <Setter Property="MinWidth" Value="110" />
  </Style>
  <Style Selector="TextBox, ComboBox, NumericUpDown, DatePicker">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="TextBox.problem">
    <Setter Property="BorderBrush" Value="{DynamicResource ProblemBrush}" />
  </Style>

  <!-- ───────────── Tables ───────────── -->
  <Style Selector="DataGrid">
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="RowHeight" Value="30" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
  </Style>

  <!-- ───────────── Status glyphs ───────────── -->
  <Style Selector="TextBlock.ok">
    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource ReviewBrush}" />
  </Style>
  <Style Selector="TextBlock.bad">
    <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
  </Style>
  <Style Selector="TextBlock.progress">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="PathIcon.ok">
    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
  </Style>
  <Style Selector="PathIcon.warn">
    <Setter Property="Foreground" Value="{DynamicResource ReviewBrush}" />
  </Style>
  <Style Selector="PathIcon.bad">
    <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
  </Style>

  <!-- ───────────── Tabs ───────────── -->
  <Style Selector="TabControl.page">
    <Setter Property="Padding" Value="0,10,0,0" />
  </Style>
  <Style Selector="TabControl.page TabItem">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="TabControl.page TabItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ───────────── Overlays ───────────── -->
  <Style Selector="Grid.overlay">
    <Setter Property="Background" Value="{DynamicResource OverlayBackdrop}" />
  </Style>
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="0 18 48 0 #40000000" />
  </Style>
</Styles>
