<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RefractionStudio.App"
             x:Class="RefractionStudio.App.App"
             Name="Refraction Studio"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <!-- QuakeLogic typefaces: Barlow for text, Oswald for uppercase section labels. -->
      <FontFamily x:Key="BrandFont">avares://RefractionStudio/Assets/Fonts#Barlow</FontFamily>
      <FontFamily x:Key="BrandLabelFont">avares://RefractionStudio/Assets/Fonts#Oswald</FontFamily>
      <FontFamily x:Key="MonoFont">Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

      <!-- QuakeLogic brand colours -->
      <Color x:Key="BrandOrange">#ED6A23</Color>
      <Color x:Key="BrandOrangeDeep">#E1590F</Color>
      <Color x:Key="BrandNearBlack">#151517</Color>
      <Color x:Key="BrandInk">#231F20</Color>
      <SolidColorBrush x:Key="HeaderBackground" Color="#151517" />
      <SolidColorBrush x:Key="HeaderForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="HeaderMuted" Color="#A3A4A7" />
      <SolidColorBrush x:Key="HeaderHover" Color="#2A2A2E" />
      <SolidColorBrush x:Key="HeaderDivider" Color="#333338" />
      <SolidColorBrush x:Key="BrandOrangeBrush" Color="#ED6A23" />

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackground" Color="#F5F5F7" />
          <SolidColorBrush x:Key="SidebarBackground" Color="#EEEEF0" />
          <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SubtleBackground" Color="#F3F3F4" />
          <SolidColorBrush x:Key="HoverBackground" Color="#E9E9EC" />
          <SolidColorBrush x:Key="SelectedBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BorderBrush" Color="#E3E3E5" />
          <SolidColorBrush x:Key="StrongBorderBrush" Color="#CFCFD3" />
          <SolidColorBrush x:Key="PrimaryText" Color="#231F20" />
          <SolidColorBrush x:Key="SecondaryText" Color="#6E6F72" />
          <SolidColorBrush x:Key="MutedText" Color="#77787B" />
          <SolidColorBrush x:Key="AccentBrush" Color="#ED6A23" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#B9500F" />
          <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryButtonBackground" Color="#231F20" />
          <SolidColorBrush x:Key="PrimaryButtonHover" Color="#000000" />
          <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OkBrush" Color="#1E8449" />
          <SolidColorBrush x:Key="ReviewBrush" Color="#B26A00" />
          <SolidColorBrush x:Key="ProblemBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="OkBackground" Color="#F1F8F3" />
          <SolidColorBrush x:Key="ReviewBackground" Color="#FDF6EC" />
          <SolidColorBrush x:Key="ProblemBackground" Color="#FCF1F0" />
          <SolidColorBrush x:Key="InfoBackground" Color="#F3F3F4" />
          <SolidColorBrush x:Key="OverlayBackdrop" Color="#66151517" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackground" Color="#151517" />
          <SolidColorBrush x:Key="SidebarBackground" Color="#1B1B1E" />
          <SolidColorBrush x:Key="PanelBackground" Color="#202024" />
          <SolidColorBrush x:Key="SubtleBackground" Color="#26262B" />
          <SolidColorBrush x:Key="HoverBackground" Color="#2C2C31" />
          <SolidColorBrush x:Key="SelectedBackground" Color="#2E2E34" />
          <SolidColorBrush x:Key="BorderBrush" Color="#323238" />
          <SolidColorBrush x:Key="StrongBorderBrush" Color="#45454C" />
          <SolidColorBrush x:Key="PrimaryText" Color="#EDEDEF" />
          <SolidColorBrush x:Key="SecondaryText" Color="#A3A4A7" />
          <SolidColorBrush x:Key="MutedText" Color="#8C8D91" />
          <SolidColorBrush x:Key="AccentBrush" Color="#ED6A23" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#F28A52" />
          <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryButtonBackground" Color="#EDEDEF" />
          <SolidColorBrush x:Key="PrimaryButtonHover" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#151517" />
          <SolidColorBrush x:Key="OkBrush" Color="#4CC36E" />
          <SolidColorBrush x:Key="ReviewBrush" Color="#F2B544" />
          <SolidColorBrush x:Key="ProblemBrush" Color="#FF6B5B" />
          <SolidColorBrush x:Key="OkBackground" Color="#1A2A20" />
          <SolidColorBrush x:Key="ReviewBackground" Color="#2E2715" />
          <SolidColorBrush x:Key="ProblemBackground" Color="#331D1B" />
          <SolidColorBrush x:Key="InfoBackground" Color="#26262B" />
          <SolidColorBrush x:Key="OverlayBackdrop" Color="#99000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RefractionStudio/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <!-- Standard controls (check boxes, switches, sliders, focus, selection, tabs) use the QuakeLogic orange. -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#FFED6A23" RegionColor="#FFFFFFFF" ErrorText="#FFC42B1C" />
        <ColorPaletteResources x:Key="Dark" Accent="#FFED6A23" RegionColor="#FF202024" ErrorText="#FFFF6B5B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://RefractionStudio/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
