# Copy to server/.env (never commit it) and fill in. docker compose reads it automatically.
# Secrets that are files (signing keys, pepper) live in server/secrets/ — see docs/licensing/LICENSE-SERVER.md.

# Image tag to build/run.
TAG=1.0.0

# PostgreSQL password for the "licensing" database user (generate: openssl rand -base64 30).
POSTGRES_PASSWORD=

# Public host names (used in documentation and the reverse proxy; the apps listen on plain HTTP behind it).
LICENSE_SERVER_HOST=licensing.quakelogic.net
ADMIN_PORTAL_HOST=licensing-admin.quakelogic.net

# Networks of the TLS reverse proxy whose X-Forwarded-For/Proto headers are trusted (CIDR, comma separated).
# 172.16.0.0/12 covers Docker bridge networks when the proxy runs on the host and connects to the published ports.
REVERSE_PROXY_NETWORKS=172.16.0.0/12

# Stripe webhook endpoint signing secret (Dashboard → Developers → Webhooks → endpoint → Signing secret).
STRIPE_WEBHOOK_SECRET=

# SMTP relay for customer e-mail (licence keys, receipts, reminders).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=licensing@quakelogic.net
SMTP_FROM_NAME=QuakeLogic Refraction Studio

# Customer-facing links in e-mails.
SUPPORT_ADDRESS=support@quakelogic.net
DOWNLOAD_URL=https://www.quakelogic.net/refraction-studio/download

# First administrator of the admin portal, created on first start when no admin exists.
# Remove the password from this file after the first successful sign-in.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
