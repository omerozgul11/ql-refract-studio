@page
@model RefractionStudio.AdminPortal.Pages.Trials.IndexModel
@{
    ViewData["Title"] = "Trials";
}
<h1>Trials</h1>
<p class="muted">One trial per computer and product. Reinstalling does not reset a trial; a computer with one changed hardware component is still recognised.</p>
<form method="get" class="row">
    <label>Search <input type="search" name="q" value="@Model.Query" placeholder="Fingerprint prefix, computer name, e-mail" /></label>
    <label>State
        <select name="state">
            <option value="">All</option>
            <option value="active" selected="@(Model.State == "active")">Active</option>
            <option value="expiring" selected="@(Model.State == "expiring")">Ending within 3 days</option>
            <option value="expired" selected="@(Model.State == "expired")">Ended</option>
        </select>
    </label>
    <button type="submit" class="secondary">Filter</button>
</form>
<div class="table-wrap">
    <table>
        <thead><tr><th>Computer</th><th>Product</th><th>Started</th><th>Ends</th><th>Last seen</th><th>Contact</th>@if (Model.CanWrite) { <th>Extend</th> }</tr></thead>
        <tbody>
        @foreach (var t in Model.Rows)
        {
            var ended = t.EndsAt <= Model.Now;
            <tr>
                <td>@(t.MachineName ?? "(name not shared)")<br /><span class="mono muted">@Fmt.Hash(t.Fingerprint)</span> <span class="small muted">@t.AppVersion</span></td>
                <td>@t.Product</td>
                <td>@Fmt.Date(t.StartedAt)</td>
                <td><span class="badge @(ended ? "expired" : t.EndsAt <= Model.Now.AddDays(3) ? "expiring" : "active")">@Fmt.Time(t.EndsAt)</span>
                    @if (t.ExtendedByAdmin) { <span class="small muted">extended</span> }</td>
                <td>@Fmt.Time(t.LastSeen)</td>
                <td>
                    @if (Model.CanWrite)
                    {
                        <form method="post" asp-page-handler="Email" asp-route-trialId="@t.Id" asp-route-q="@Model.Query" asp-route-state="@Model.State" class="row">
                            <input type="email" name="Email" value="@t.Email" placeholder="for the reminder" />
                            <button type="submit" class="small secondary">Save</button>
                        </form>
                    }
                    else { @(t.Email ?? "—") }
                </td>
                @if (Model.CanWrite)
                {
                    <td>
                        <form method="post" asp-page-handler="Extend" asp-route-trialId="@t.Id" asp-route-q="@Model.Query" asp-route-state="@Model.State" class="row">
                            <input type="number" name="Days" value="7" min="1" max="365" />
                            <button type="submit" class="small">Extend</button>
                        </form>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model.Paging" />
