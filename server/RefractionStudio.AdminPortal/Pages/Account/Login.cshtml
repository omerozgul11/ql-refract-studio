@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="login panel">
    <h1>Sign in</h1>
    @if (Model.Error is not null)
    {
        <div class="flash error" role="alert">@Model.Error</div>
    }
    <form method="post" class="stack">
        <input type="hidden" asp-for="ReturnUrl" />
        <label>E-mail <input asp-for="Email" type="email" autocomplete="username" required autofocus /></label>
        <label>Password <input asp-for="Password" type="password" autocomplete="current-password" required /></label>
        <button type="submit">Sign in</button>
    </form>
    <p class="muted small">Five failed attempts lock the account for 15 minutes.</p>
</div>
