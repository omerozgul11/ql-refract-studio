@page
@model RefractionStudio.AdminPortal.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Customers";
}
<div class="toolbar">
    <h1>Customers</h1>
    @if (Model.CanWrite) { <a class="button" asp-page="/Licenses/Create">New licence</a> }
</div>
<form method="get" class="row">
    <label>Search <input type="search" name="q" value="@Model.Query" placeholder="E-mail, name or company" /></label>
    <button type="submit" class="secondary">Search</button>
</form>
<div class="table-wrap">
    <table>
        <thead><tr><th>Customer</th><th>E-mail</th><th>Company</th><th>Licences</th><th>Since</th></tr></thead>
        <tbody>
        @foreach (var c in Model.Rows)
        {
            <tr>
                <td><a asp-page="Details" asp-route-id="@c.Id">@(string.IsNullOrWhiteSpace(c.Name) ? "(no name)" : c.Name)</a></td>
                <td>@c.Email</td>
                <td>@(c.Company ?? "—")</td>
                <td>@c.Licenses</td>
                <td>@Fmt.Date(c.CreatedAt)</td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model.Paging" />
