{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Licensing": ""
  },
  "Licensing": {
    "AutoMigrate": false,
    "TrialOfflineDays": 3
  },
  "RateLimits": {
    "LicensePerMinute": 30,
    "ActivationPerMinute": 10,
    "ActivationsPerKeyPerHour": 20
  },
  "ReverseProxy": {
    "KnownProxies": "",
    "KnownNetworks": ""
  },
  "Hosting": {
    "HttpsRedirection": true
  },
  "Workers": {
    "EmailPollSeconds": 15,
    "MaintenanceMinutes": 60
  },
  "Email": {
    "CompanyName": "QuakeLogic Inc.",
    "SupportAddress": "support@quakelogic.net",
    "DownloadUrl": "https://www.quakelogic.net/refraction-studio/download",
    "TrialReminderDays": 3
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "FromAddress": "licensing@quakelogic.net",
    "FromName": "QuakeLogic Refraction Studio"
  },
  "Stripe": {
    "ToleranceSeconds": 300,
    "DefaultProduct": "refraction-studio",
    "DefaultMaintenanceDays": 365
  }
}
