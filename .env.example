# Refraction Studio — local build and release settings.
# Copy to .env (gitignored, never commit it) and fill in. packaging/package_windows.py reads it.
# Licence-server deployment settings are separate: see server/.env.example.

# Release-signing private key (PEM) used to sign the update manifest. Generate a key pair with
#   dotnet run --project tools/RefractionStudio.Cli -- keys --out .secrets/release-signing
# and keep the private key out of the repository (.secrets/ is gitignored).
RS_RELEASE_SIGNING_KEY=

# Base URL of the published installers; the version folder and file name are appended:
#   <base>/v1.0.0/RefractionStudio-1.0.0-win-x64-setup.exe
RS_DOWNLOAD_BASE_URL=https://github.com/omerozgul11/ql-refract-studio/releases/download

# SignTool command for Inno Setup's "rssign" sign tool (used with --sign); $f is the file to sign.
# Example (certificate in the Windows certificate store, selected by thumbprint):
#   "C:\Program Files (x86)\Windows Kits\10\bin\x64\signtool.exe" sign /fd sha256 /tr http://timestamp.example.com /td sha256 /sha1 <THUMBPRINT> $f
RS_SIGNTOOL_COMMAND=

# Optional: relocate the application data folder (support and tests); empty = %LocalAppData%\QuakeLogic\RefractionStudio.
REFRACTIONSTUDIO_DATA_DIR=

# GitHub personal access token (fine-grained, this repository only, Contents: Read and write) used by
# packaging/publish_release.py to create releases and upload the installer. Never commit it.
GITHUB_TOKEN=
GITHUB_REPOSITORY=omerozgul11/ql-refract-studio

# Licence-signing private key (PEM) for issuing internal or offline licences with the CLI.
RS_LICENSE_SIGNING_KEY=
